{
  "name": "planner",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --if-present --workspaces build",
    "typecheck": "bun run --if-present --workspaces typecheck",
    "test": "bun run --if-present --workspaces test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "deploy": "bun run --cwd apps/web deploy",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "check:clean": "scripts/check-clean-head.sh"
  },
  "devDependencies": {
    "lefthook": "2.1.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.4"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "bun@1.4.2"
}
